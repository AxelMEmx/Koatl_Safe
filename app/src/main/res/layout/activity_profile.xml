<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_tech_dark_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koatl Safe"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configura tu perfil de emergencia"
            android:textSize="14sp"
            android:textColor="#BBBBBB"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DATOS PERSONALES"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/blue_tech_accent"
                android:letterSpacing="0.05"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre completo *"
                android:textSize="13sp"
                android:textColor="#CCCCCC"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej: Maria Lopez Garcia"
                android:textColor="@color/white"
                android:textColorHint="#666666"
                android:inputType="textPersonName"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/blue_tech_accent"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edad *"
                android:textSize="13sp"
                android:textColor="#CCCCCC"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etEdad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej: 22"
                android:textColor="@color/white"
                android:textColorHint="#666666"
                android:inputType="number"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/blue_tech_accent"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo de sangre"
                android:textSize="13sp"
                android:textColor="#CCCCCC"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerSangre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Domicilio *"
                android:textSize="13sp"
                android:textColor="#CCCCCC"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etDomicilio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Calle, numero, colonia, ciudad"
                android:textColor="@color/white"
                android:textColorHint="#666666"
                android:inputType="textMultiLine"
                android:lines="2"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/blue_tech_accent"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alergias y condiciones medicas"
                android:textSize="13sp"
                android:textColor="#CCCCCC"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etAlergias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej: Alergico a penicilina, asma, diabetes tipo 2"
                android:textColor="@color/white"
                android:textColorHint="#666666"
                android:inputType="textMultiLine"
                android:lines="2"
                android:backgroundTint="@color/blue_tech_accent"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar y continuar"
            android:backgroundTint="@color/blue_tech_accent"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="14dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* Campos obligatorios"
            android:textSize="11sp"
            android:textColor="#888888"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>
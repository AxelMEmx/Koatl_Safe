<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFF6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koatl Safe"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1B3A5C"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sistema de emergencia medica"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Banner emergencia activa -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutEmergenciaActiva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#DC2626"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EMERGENCIA ACTIVA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvUltimaUbicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enviando ubicacion..."
                    android:textSize="12sp"
                    android:textColor="#FECACA"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnEstoyBien"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estoy bien — Detener emergencia"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#DC2626"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>


            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Perfil del usuario -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Paciente"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#6B7280"/>

                    <TextView
                        android:id="@+id/tvEditarPerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Editar perfil"
                        android:textSize="12sp"
                        android:textColor="#1B3A5C"
                        android:textStyle="bold"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvPerfilNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvPerfilDatos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#6B7280"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Estado de conexion -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado de la pulsera"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvEstado"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Desconectado"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#DC2626"/>

                    <View
                        android:id="@+id/indicadorConexion"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#DC2626"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDispositivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buscando dispositivo..."
                    android:textSize="13sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Contactos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Contactos de emergencia"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#6B7280"/>

                    <TextView
                        android:id="@+id/tvEditarContactos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Editar"
                        android:textSize="12sp"
                        android:textColor="#1B3A5C"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- Contacto 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Llamada"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:background="#1B3A5C"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvContacto1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sin configurar"
                        android:textSize="14sp"
                        android:textColor="#111827"
                        android:paddingLeft="10dp"/>

                </LinearLayout>

                <!-- Contacto 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SMS     "
                        android:textSize="10sp"
                        android:textColor="#374151"
                        android:background="#F3F4F6"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvContacto2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sin configurar"
                        android:textSize="14sp"
                        android:textColor="#111827"
                        android:paddingLeft="10dp"/>

                </LinearLayout>

                <!-- Contacto 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SMS     "
                        android:textSize="10sp"
                        android:textColor="#374151"
                        android:background="#F3F4F6"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvContacto3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sin configurar"
                        android:textSize="14sp"
                        android:textColor="#111827"
                        android:paddingLeft="10dp"/>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Instrucciones -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Como usar"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Presiona el boton de la pulsera durante 5 segundos para activar la alerta. Tendras 10 segundos para cancelar si fue un error."
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Para detener la emergencia presiona ESTOY BIEN. Tus contactos recibiran aviso de que estas bien."
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:lineSpacingExtra="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Boton probar -->
        <Button
            android:id="@+id/btnProbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Probar app"
            android:backgroundTint="#1B3A5C"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_tech_dark_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koatl Safe"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sistema de emergencia discreta"
            android:textSize="14sp"
            android:textColor="#BBBBBB"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Banner emergencia activa -->
        <LinearLayout
            android:id="@+id/layoutEmergenciaActiva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#C0392B"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EMERGENCIA ACTIVA"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvUltimaUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enviando ubicacion..."
                android:textSize="12sp"
                android:textColor="#FFCCCC"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnEstoyBien"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ESTOY BIEN - Detener emergencia"
                android:backgroundTint="#FFFFFF"
                android:textColor="#C0392B"
                android:textStyle="bold"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- Perfil del usuario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Perfil activo"
                    android:textSize="12sp"
                    android:textColor="@color/blue_tech_accent"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvEditarPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Editar"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvPerfilNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvPerfilDatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#DDDDDD"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Estado de conexion -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado de conexion"
                android:textSize="12sp"
                android:textColor="@color/blue_tech_accent"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Desconectado"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#E74C3C"/>

            <TextView
                android:id="@+id/tvDispositivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscando PulseraSOS..."
                android:textSize="13sp"
                android:textColor="#BBBBBB"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Contactos de emergencia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Contactos de emergencia"
                    android:textSize="12sp"
                    android:textColor="@color/blue_tech_accent"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvAgregarContacto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Agregar"
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llContactos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView
                android:id="@+id/tvSinContactos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin contactos agregados aun"
                android:textSize="13sp"
                android:textColor="#888888"
                android:gravity="center"
                android:padding="8dp"
                android:visibility="visible"/>

        </LinearLayout>


        <!-- Instrucciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Como funciona"
                android:textSize="12sp"
                android:textColor="@color/blue_tech_accent"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Para verificar que todo funciona:\nPresiona el boton Probar app o usa el sensor de la pulsera.\n\nComo usar en emergencia:\nManten presionado el sensor 5 segundos. Tendras 10 segundos para cancelar si fue un error.\n\nComo detener la emergencia:\nPresiona ESTOY BIEN. Tus contactos recibiran aviso de que estas bien."
                android:textSize="14sp"
                android:textColor="#EEEEEE"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

        <!-- Boton probar -->
        <Button
            android:id="@+id/btnProbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Probar app"
            android:backgroundTint="@color/blue_tech_primary"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="14dp"
            android:layout_marginBottom="16dp"/>
    </LinearLayout>
</ScrollView>